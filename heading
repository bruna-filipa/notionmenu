
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    * {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      padding: 0;
      background: transparent;
      overflow: hidden;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont,
        "Segoe UI", Arial, sans-serif;
    }

    .dashboard-title {
      color: #791611;
      font-size: 32px;
      font-weight: 750;
      line-height: 1.3;
      letter-spacing: -0.6px;
      margin: 0;
    }

    .title-underline {
      width: 110px;
      height: 3px;
      background: #DEA6AE;
      border-radius: 10px;
      margin-top: 12px;
    }

    @media (max-width: 600px) {
      .dashboard-title {
        font-size: 25px;
      }
    }
  </style>
</head>

<body>
  <h1 class="dashboard-title">
    My Work Dashboard | Warner Music Group
  </h1>

  <div class="title-underline"></div>
</body>
</html>
